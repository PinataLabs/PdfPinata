<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Both legs, unlike the generator tests. What these cover is the renderer at runtime, and the
      renderer ships on net8.0 and net10.0 as well as netstandard2.1; a layout decision that came
      out differently on one of them would show here and nowhere else.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.5.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
    <ProjectReference Include="..\PinataLayout.Rendering\PinataLayout.Rendering.csproj" />
    <!--
      A backend, because the core package carries no font or imaging dependency of its own and a
      document cannot be laid out without one. Skia is the default, and nothing here is about which
      backend is in use.
    -->
    <ProjectReference Include="..\PdfPinata.Skia\PdfPinata.Skia.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked from the main test project rather than written again here. These four read a page's
      content stream back - what it strokes, where it draws text, which operators it used - and
      between them they are three hundred lines of exacting detail: following q/Q so an inner
      scope's line width is not reported for everything after it, holding a path back until the
      operator that says whether it is stroked, tracking the text line matrix through T* and the
      quote operators. A second copy would be a second thing to get right, and would drift.

      They keep their own namespace, PdfPinata.Test.Helpers, so that the file linked is the file
      as it stands there. That is why the tests below carry a using for a namespace named after the
      other test project. Compiling the source needs no project reference, so this does not couple
      the two builds - only their content.
    -->
    <Compile Include="..\PdfPinata.Test\Helpers\PageContent.cs" Link="Helpers\Linked\PageContent.cs" />
    <Compile Include="..\PdfPinata.Test\Helpers\StrokedLines.cs" Link="Helpers\Linked\StrokedLines.cs" />
    <Compile Include="..\PdfPinata.Test\Helpers\TextBaselines.cs" Link="Helpers\Linked\TextBaselines.cs" />
    <Compile Include="..\PdfPinata.Test\Helpers\TextOperators.cs" Link="Helpers\Linked\TextOperators.cs" />
    <!--
      The one fact that decides what every layout assertion here sees: which font stands in for
      Arial. It used to be a smaller copy of its own; linked now, for the same reason as the four
      readers above.
    -->
    <Compile Include="..\PdfPinata.Test\Helpers\PinnedFontResolver.cs" Link="Helpers\Linked\PinnedFontResolver.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked from the main test project rather than checked in again. The same reasoning applies
      here as there - glyph widths decide where a line wraps, so a layout assertion needs the same
      font on every machine - and two copies of the same four files would be two things to keep in
      step. See Helpers/Linked/PinnedFontResolver.cs.

      All four faces the linked resolver can hand out, not only the Liberation Sans ones: it
      answers the CFF, Arabic and Devanagari families by name too, and a project that linked the
      class without linking what it reads would have it throw FileNotFoundException the day a test
      here asks for one of them by name, instead of the "not shipped here" it would get from a
      resolver that never heard of that family.
    -->
    <None Include="..\PdfPinata.Test\Assets\Fonts\LiberationSans-*.ttf"
          Link="Assets\Fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\SourceCodePro-Regular.otf"
          Link="Assets\Fonts\SourceCodePro-Regular.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\NotoSansArabic-Regular.ttf"
          Link="Assets\Fonts\NotoSansArabic-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\NotoSansDevanagari-Regular.ttf"
          Link="Assets\Fonts\NotoSansDevanagari-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\LICENSE.txt"
          Link="Assets\Fonts\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      One image, for the tagging tests: an image is either a described figure or an artifact, and
      deciding which needs a real image that the backend will actually decode. Linked rather than
      copied for the same reason as the fonts.
    -->
    <None Include="..\PdfPinata.Test\Assets\lenna.png" Link="Assets\lenna.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
