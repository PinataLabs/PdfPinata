<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      One target framework rather than the library's two, because "dotnet run" refuses to pick
      between them and this app exists to be easy to run. net8.0 rather than net10.0
      because PdfPinata.Test references this project and builds a net8.0 leg, which could not
      reference a net10.0 one. What builds here therefore builds on the lowest framework the library
      supports; the multi-framework matrix stays the test project's job.
    -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!--
      Trimming is deliberately not configured here. PinataLayout.AotSmokeTest is the project that
      guards trim and AOT, with the analyzers switched on and a native publish that CI actually
      runs. Spectre.Console, System.CommandLine and the PinataLayout renderer would each raise IL2xxx
      warnings that say nothing about this app, and warnings nobody can act on are how people learn
      to ignore the analyzer that matters.
    -->
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
    <ProjectReference Include="..\PdfPinata.Skia\PdfPinata.Skia.csproj" />
    <ProjectReference Include="..\PinataLayout.Rendering\PinataLayout.Rendering.csproj" />
    <!--
      Already here transitively - PinataLayout.Rendering references it, because a PinataLayout chart is
      mapped onto this engine to be drawn - so this line adds no dependency the app did not have.
      It is written out because the Charts demo uses the charting API directly as well as through
      PinataLayout, and a reference a reader cannot see in the project file is one they cannot rely on.
    -->
    <ProjectReference Include="..\PdfPinata.Charting\PdfPinata.Charting.csproj" />
    <!--
      The shaper, for the International demo. A package of its own rather than part of a backend,
      so taking it does not oblige a choice of imaging backend - see docs/specs/text-shaping-and-bidi.md.
      It is registered in Backends beside the other seams and nowhere else: a demo that set
      GlobalFontSettings.TextShaper itself would be changing a setting shared with every test
      running beside it in the smoke-test host.
    -->
    <ProjectReference Include="..\PdfPinata.HarfBuzz\PdfPinata.HarfBuzz.csproj" />
    <!--
      The cryptography, for the Signing demo. The core package holds all the PDF machinery of a
      signature - the placeholder, the byte range, the patching - and no cryptography at all, behind
      the IPdfSigner seam; this is the package that carries the dependency the core refuses. It is
      also the one shipped package that does not target netstandard2.1, which is why signing is a
      package of its own and not part of the core.
    -->
    <ProjectReference Include="..\PdfPinata.Signing\PdfPinata.Signing.csproj" />
    <!--
      The hybrid e-invoice helper, for the FacturX demo. Nothing the core could not do - it writes a
      file specification and a string of RDF/XML - but every part of it is silent when got wrong, so
      it is a package rather than a paragraph of documentation. It carries no dependency of its own,
      which is why this line costs the app nothing but a project reference.
    -->
    <ProjectReference Include="..\PdfPinata.EInvoice\PdfPinata.EInvoice.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Each demo prints its own source, read back out of this assembly, so what appears on the
      terminal cannot drift from what drew the PDF. The files stay Compile items as well - these
      are the same bytes, every build.

      Embedded rather than copied beside the binary because a referenced project's content items do
      not reach the referencing project's output directory, and PdfPinata.Test references this
      one. Embedding also survives publishing and does not care what the working directory is.
    -->
    <EmbeddedResource Include="Demos\**\*.cs" LogicalName="Sources/%(Filename)%(Extension)" />

    <!--
      The fonts, so that a document is laid out identically wherever it is built - including a
      Linux agent with no fonts installed at all - and the photograph the image demos draw.
    -->
    <EmbeddedResource Include="Assets\Fonts\*.ttf" LogicalName="Fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Fonts\*.otf" LogicalName="Fonts/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Images\*.jpg" LogicalName="Images/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\Images\*.png" LogicalName="Images/%(Filename)%(Extension)" />

    <!--
      The licence travels with the fonts. The SIL OFL requires its text to be distributed
      with the font software, and embedding the faces without it would ship them stripped of
      the one file that permits shipping them at all.
    -->
    <EmbeddedResource Include="Assets\Fonts\LICENSE.txt" LogicalName="Fonts/LICENSE.txt" />
  </ItemGroup>

</Project>
