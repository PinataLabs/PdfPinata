<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <!-- Ship the XML documentation alongside the assembly, so a consumer of the package gets the
         doc comments as IntelliSense. This project is clean of CS1591, so a public member added
         without one now warns. Set per project rather than in Directory.Build.props, which is
         imported before IsPackable is known, or Directory.Build.targets, which is
         imported after the SDK has already derived DocumentationFile from it. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>ImageSharp imaging and font backend for PdfPinata.

Provides ImageSharpImageSource and ImageSharpFontResolver. Pinned to the Apache-2.0 licensed SixLabors 2.1.x / 1.0.x lines; later SixLabors releases use the Six Labors Split License.</Description>
    <summary>ImageSharp backend for PdfPinata</summary>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- ImageSharp 3.0 is not binary compatible with 2.1.x: the Load(..., out IImageFormat)
         overloads were removed and every encoder property changed from set to init, which
         alters the setter signature. Code compiled here against 2.1.x throws
         MissingMethodException if the consumer's graph unifies ImageSharp to 3.x, so the
         upper bound turns that into a restore-time version conflict instead. See #348. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="[2.1.13,3.0.0)" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
  </ItemGroup>

</Project>
