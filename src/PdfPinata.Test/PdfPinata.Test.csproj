<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0;net11.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- The page rendering seam is experimental, and its tests are what use it. -->
    <NoWarn>$(NoWarn);PPEXP001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.5.3" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.5.3" />
    <PackageReference Include="TUnit.Engine" Version="1.84.0" />
    <PackageReference Include="Ghostscript.NativeAssets" Version="10.8.0" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.201" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.macOS" Version="14.2.1.201" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Win32" Version="14.2.1.201" />
    <PackageReference Include="Magick.NET-Q8-AnyCPU" Version="14.17.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.156.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.156.0" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
    <ProjectReference Include="..\PinataLayout.Rendering\PinataLayout.Rendering.csproj" />
    <ProjectReference Include="..\PdfPinata.Signing\PdfPinata.Signing.csproj" />
    <ProjectReference Include="..\PdfPinata.EInvoice\PdfPinata.EInvoice.csproj" />
    <ProjectReference Include="..\PdfPinata.HarfBuzz\PdfPinata.HarfBuzz.csproj" />
    <ProjectReference Include="..\PdfPinata.Skia\PdfPinata.Skia.csproj" />
    <ProjectReference Include="..\PdfPinata.ImageSharp\PdfPinata.ImageSharp.csproj" />
    <!--
      So that the demonstration app's demos can be run by the smoke tests. The app targets
      net8.0 alone, which both legs of this project can reference.
    -->
    <ProjectReference Include="..\SampleApp\SampleApp.csproj" />
  </ItemGroup>

  <!--
    The Blazor WebAssembly sample is a browser app targeting net10.0 alone, so it is not referenced.
    The two classes of it that need no browser are plain C# and are compiled here as source, with
    the image and the encrypted document they are handed in the app, for BlazorWasmSampleTests.
  -->
  <ItemGroup>
    <Compile Include="..\SampleBlazorWasm\SampleDocument.cs" Link="Samples\Linked\SampleDocument.cs" />
    <Compile Include="..\SampleBlazorWasm\EncryptedSample.cs" Link="Samples\Linked\EncryptedSample.cs" />
    <None Include="..\SampleBlazorWasm\wwwroot\images\alpha-badge.png" Link="Assets\SampleBlazorWasm\alpha-badge.png" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\SampleBlazorWasm\wwwroot\samples\aes-256.pdf" Link="Assets\SampleBlazorWasm\aes-256.pdf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The standard 14 metrics are internal and this repository carries no InternalsVisibleTo, so
      the two files that make them up are compiled here as source. Neither depends on anything
      else in PdfPinata.
    -->
    <Compile Include="..\PdfPinata\Fonts\Core14Metrics.cs" Link="Fonts\Linked\Core14Metrics.cs" />
    <Compile Include="..\PdfPinata\Fonts\Core14Tables.g.cs" Link="Fonts\Linked\Core14Tables.g.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*.pdf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\frog-and-toad.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Imaging\*.jpg;Assets\Imaging\*.gif;Assets\Imaging\*.webp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      CCITT facsimile data, each made by Ghostscript's encoder or ImageMagick from the bitmap
      beside it. Generate.ps1 makes them all again.
    -->
    <None Update="Assets\Ccitt\*.bin;Assets\Ccitt\*.pbm">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Fonts\*.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Fonts\*.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!--
      The pinned layout output. Checked in as a file rather than written into a test as a string
      literal: it is six hundred lines, and a literal of that size is compared against text the
      library writes with line feeds while the literal itself carries whatever line endings the
      checkout gave the file - which is how the gradient pin came to fail on Windows and pass on CI.
    -->
    <!--
      The Unicode Bidirectional Algorithm conformance suites, gzipped: 1.7 MB here against
      14.8 MB unpacked. Checked in rather than downloaded because a conformance claim that
      depends on the network is not one the build can make.
    -->
    <!--
      RFC 6229's RC4 keystreams, the key and offset lines of its section 2 exactly as printed.
    -->
    <None Update="Assets\Security\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Unicode\*.gz">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Layout\*.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
