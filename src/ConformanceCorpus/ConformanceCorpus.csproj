<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      One target framework, not the library's three. What this produces is PDF bytes, and the bytes
      do not differ by target framework - so a second leg would double the CI time and validate the
      same files twice.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>ConformanceCorpus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PinataLayout.DocumentObjectModel\PinataLayout.DocumentObjectModel.csproj" />
    <ProjectReference Include="..\PinataLayout.Rendering\PinataLayout.Rendering.csproj" />
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
    <ProjectReference Include="..\PdfPinata.EInvoice\PdfPinata.EInvoice.csproj" />
    <ProjectReference Include="..\PdfPinata.Skia\PdfPinata.Skia.csproj" />
  </ItemGroup>

  <!--
    The backend is native, and the corpus is built on a developer's Windows machine and on a Linux
    runner alike. All three so that neither has to think about it.
  -->
  <ItemGroup>
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.150.1" />
  </ItemGroup>

  <!--
    The CFF face the corpus draws one document with, linked from the demonstration app's assets
    rather than copied: a third copy of the same 128 kB would be three things to keep in step. An
    embedded resource rather than a content file, because a referenced project's content items do
    not reach the referencing project's output directory - the same rule SampleApp lives by.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\SampleApp\Assets\Fonts\SourceCodePro-Regular.otf">
      <LogicalName>ConformanceCorpus.SourceCodePro-Regular.otf</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
