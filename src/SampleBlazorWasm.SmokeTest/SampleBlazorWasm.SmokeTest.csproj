<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Drives the published Blazor WebAssembly sample in a headless browser: serves its wwwroot, clicks
    Generate, and opens the PDF the browser downloads with PdfReader. The exit code is the verdict,
    as with the AOT smoke test. .github/workflows/blazor-wasm-smoke.yml runs it.

    A console app rather than a test project, and deliberately not in PdfPinata.slnx: it needs a
    published sample and an installed browser, and "dotnet test" over the solution would otherwise
    ask both of every run and every developer. Program.cs says how to run it by hand.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Kestrel serves the published app from inside this process, so nothing runs in the background. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Playwright" Version="1.63.0" />
  </ItemGroup>

</Project>
