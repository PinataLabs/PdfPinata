<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      Both legs, as the renderer's tests do. The charting package ships on netstandard2.1, net8.0
      and net10.0, and most of what these cover is arithmetic - axis scales, column geometry, label
      placement - run through double and formatted with ToString. Both are things a BCL change
      between two target frameworks moves under you without a compiler error to say so.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <RootNamespace>PdfPinata.Charting.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="coverlet.msbuild" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
    <ProjectReference Include="..\PdfPinata.Charting\PdfPinata.Charting.csproj" />
    <!--
      No backend, and no MigraDoc. A chart draws lines, rectangles, wedges and strings: of the
      three static seams the core package leaves open it reads only GlobalFontSettings
      .FontResolver, and the resolver below answers that with font bytes the tests ship rather
      than with a backend's view of the machine. Measuring a string needs the OpenType tables and
      not an imaging library, so nothing here decodes an image or takes a glyph outline. Keeping
      that true is the line saying a test needing either belongs in PdfPinata.Test.

      MigraDoc is absent for the other direction: charting sits underneath the renderer, and a test
      that reached a chart through a Document would be covering the chart mapper instead of this.
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked from the main test project rather than copied, on the same reasoning that put them in
      PinataLayout.Rendering.Tests: they read a page's content stream back - what it strokes, what
      text it shows, where - and between them they are exacting about q/Q scoping and about holding
      a path back until the operator that says whether it is stroked. A third copy would be a third
      thing to keep right.

      They keep their own namespace, PdfPinata.Test.Helpers, so the file linked is the file as
      it stands there. Compiling the source needs no project reference, so this couples the content
      of the two projects and not their builds.
    -->
    <Compile Include="..\PdfPinata.Test\Helpers\PageContent.cs" Link="Helpers\Linked\PageContent.cs" />
    <Compile Include="..\PdfPinata.Test\Helpers\StrokedLines.cs" Link="Helpers\Linked\StrokedLines.cs" />
    <Compile Include="..\PdfPinata.Test\Helpers\TextOperators.cs" Link="Helpers\Linked\TextOperators.cs" />
    <!--
      The one fact that decides what every axis and label measurement here sees: which font stands
      in for Arial. It used to be a smaller copy of its own; linked now, for the same reason as the
      three readers above.
    -->
    <Compile Include="..\PdfPinata.Test\Helpers\PinnedFontResolver.cs" Link="Helpers\Linked\PinnedFontResolver.cs" />
    <!--
      Saving a document and reading it back, which is how a test here sees what a reader sees. One
      owner for it rather than a private copy in each file that needed one.
    -->
    <Compile Include="..\PdfPinata.Test\Helpers\Saved.cs" Link="Helpers\Linked\Saved.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      docs/specs/charting-renderer-seam.md's internal seam: renderer parameters in, computed
      geometry out. AxisTitleGeometry.cs depends on nothing but public XRect/XSize/XPoint and the
      public HorizontalAlignment/VerticalAlignment enums, so linking it - rather than adding this
      repository's first InternalsVisibleTo, or making the geometry types public - costs this
      project one more compiled copy of a small pure-arithmetic file and nothing else. The renderer
      it serves, AxisTitleRenderer.Draw, calls the same file.
    -->
    <Compile Include="..\PdfPinata.Charting\Renderers\AxisTitleGeometry.cs" Link="Renderers\Linked\AxisTitleGeometry.cs" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Linked rather than checked in again, as the renderer's tests link them. Glyph widths decide
      how wide a tick label measures, and a tick label's width decides how much room the axis
      renderer leaves itself and therefore where every column on the plot area lands. Liberation
      Sans carries the metrics of Arial, which is what the charting defaults ask for.

      All four faces the linked resolver can hand out, not only the Liberation Sans ones: it
      answers the CFF, Arabic and Devanagari families by name too, and a project that linked the
      class without linking what it reads would have it throw FileNotFoundException the day a test
      here asks for one of them by name, instead of the "not shipped here" it would get from a
      resolver that never heard of that family.
    -->
    <None Include="..\PdfPinata.Test\Assets\Fonts\LiberationSans-*.ttf"
          Link="Assets\Fonts\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\SourceCodePro-Regular.otf"
          Link="Assets\Fonts\SourceCodePro-Regular.otf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\NotoSansArabic-Regular.ttf"
          Link="Assets\Fonts\NotoSansArabic-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\NotoSansDevanagari-Regular.ttf"
          Link="Assets\Fonts\NotoSansDevanagari-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\PdfPinata.Test\Assets\Fonts\LICENSE.txt"
          Link="Assets\Fonts\LICENSE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
