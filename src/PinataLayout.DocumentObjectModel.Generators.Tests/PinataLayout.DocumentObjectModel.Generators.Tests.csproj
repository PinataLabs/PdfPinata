<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      One target framework, unlike the main test project. These exercise the generator, which runs
      inside the compiler and is TFM-agnostic; a second leg would double the run for no coverage.
    -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!--
      A normal project reference, not an analyzer one. These tests drive the generator directly
      through CSharpGeneratorDriver rather than letting the compiler run it, so they need the type.
    -->
    <ProjectReference Include="..\PinataLayout.DocumentObjectModel.Generators\PinataLayout.DocumentObjectModel.Generators.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
    <!--
      coverlet.MTP, as every test project carries it: without it CI's coverage switch is refused
      here as an unknown option, and the generator - which no other test project executes, being referenced
      everywhere else as an analyzer - would count as entirely uncovered.
    -->
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Microsoft.Testing.Extensions.CrashDump" Version="2.4.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" Version="2.4.1" />
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1" />
    <PackageReference Include="TUnit.Engine" Version="1.72.16" />
  </ItemGroup>

</Project>
