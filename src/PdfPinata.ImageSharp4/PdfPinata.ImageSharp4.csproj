<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- ImageSharp 4.x and Fonts 3.x target net8.0 alone, so this package has no netstandard2.1
         (Unity) build. PdfPinata.ImageSharp, on the 2.1.x line, keeps that one. See #305. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- The Six Labors community key in this folder is scoped to this assembly name and no other,
         so it must not change. docs/specs/sixlabors-licence-key.md says more. -->
    <AssemblyName>PdfPinata.ImageSharp4</AssemblyName>
    <DefineConstants>$(DefineConstants);IMAGESHARP4</DefineConstants>
    <!-- Ship the XML documentation alongside the assembly; see PdfPinata.ImageSharp.csproj for why
         this is set per project. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>ImageSharp 4 imaging and font backend for PdfPinata.

Provides ImageSharpImageSource, ImageSharpFontResolver and ImageSharpGlyphOutlineProvider, built against SixLabors.ImageSharp 4.x and SixLabors.Fonts 3.x, which are under the Six Labors Split License. The same types and namespaces as PdfPinata.ImageSharp, which stays on the Apache-2.0 licensed 2.1.x line; that line is end of life and carries security advisories that will not be fixed, so prefer this package unless you need netstandard2.1 (Unity) or the Apache-2.0 licence. Images decode to the same pixels as PdfPinata.ImageSharp: embedded colour profiles are kept, not applied.</Description>
    <summary>ImageSharp 4 backend for PdfPinata</summary>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
  </PropertyGroup>

  <ItemGroup>
    <!-- 4.1.2 is the first 4.x release clear of the advisories against 2.1.x and 3.x. The next
         major is assumed not binary compatible, as 3.0 was not with 2.1, so the upper bound turns a
         consumer's unification onto 5.x into a restore-time version conflict rather than a
         MissingMethodException at run time. Fonts is bounded the same way: Fonts 3 changed the
         glyph renderer interface this backend implements, and its next major may again. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="[4.1.3,5.0.0)" />
    <PackageReference Include="SixLabors.Fonts" Version="[3.2.0,4.0.0)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
  </ItemGroup>

  <!--
    The backend's source lives in src/ImageSharpBackend and is shared with PdfPinata.ImageSharp. The
    calls that differ between ImageSharp 2.1.x and 4.x sit behind the IMAGESHARP4 constant defined
    above. One copy of each file, so a fix reaches both packages. See #305.
  -->
  <ItemGroup>
    <Compile Include="..\ImageSharpBackend\*.cs" Link="%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
