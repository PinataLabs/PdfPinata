<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net8.0;net10.0</TargetFrameworks>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <Authors>Stefan Steiger and Contributors</Authors>
    <Description>HarfBuzz text shaping backend for PdfPinata.

Provides HarfBuzzTextShaper, an ITextShaper for GlobalFontSettings.TextShaper, so that Arabic joins, Devanagari reorders, and Latin kerns and ligates. Depends on HarfBuzzSharp alone rather than on SkiaSharp, so it is usable from either imaging backend or from neither. HarfBuzzSharp is a native library: consumers must also reference the HarfBuzzSharp.NativeAssets package for their target platform.</Description>
    <Copyright>Copyright (c) 2026 PdfPinata; Copyright (c) 2005-2007 empira Software GmbH, Cologne (Germany)</Copyright>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE.md</PackageLicenseFile>
    <PackageProjectUrl>https://github.com/PinataLabs/PdfPinata</PackageProjectUrl>
    <RepositoryUrl>https://github.com/PinataLabs/PdfPinata</RepositoryUrl>
    <summary>HarfBuzz shaping backend for PdfPinata</summary>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>TRACE;DEBUG;</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>TRACE;RELEASE;</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!--
      HarfBuzzSharp on its own, not SkiaSharp.HarfBuzz. The whole reason this is a package of its
      own rather than a class in PdfPinata.Skia is that shaping must not require the Skia
      imaging backend - PdfPinata.ImageSharp is pinned to SixLabors.Fonts 1.0.1 for licence
      reasons and cannot shape for itself. It targets netstandard2.1, so the Unity leg survives.
    -->
    <PackageReference Include="HarfBuzzSharp" Version="14.2.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PdfPinata\PdfPinata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\LICENSE.md" Pack="true" PackagePath="" />
    <None Include="..\README.md" Pack="true" PackagePath="" />
  </ItemGroup>

</Project>
