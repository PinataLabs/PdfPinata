# EditorConfig - https://editorconfig.org
root = true

# The file-scoped namespace conversion stripped the trailing newline from 725
# files, which adds a spurious "\ No newline at end of file" line to every
# subsequent diff that touches the end of a file. This stops it recurring.
#
# Line endings are deliberately not set here: .gitattributes normalises them
# with "* text=auto", so leaving end_of_line unspecified avoids the two
# fighting each other.
[*]
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8

# Binary assets. src/PdfPinata.Test/Assets/NotAValid.pdf is a deliberately
# malformed PDF read byte for byte by src/PdfPinata.Test/IO/PdfReader.cs, so
# nothing should be appended to it.
[*.pdf]
insert_final_newline = false
trim_trailing_whitespace = false

# Markdown uses two trailing spaces as a hard line break.
[*.md]
trim_trailing_whitespace = false

# Test code: the performance-only analyzer rules are off. A test states the value it expects where it
# asserts it, and hoisting that array into a static field (CA1861), narrowing a helper's return type
# (CA1859) or source-generating a regex that runs once (SYSLIB1045) would make the test harder to
# read and buy nothing. Every other rule applies to tests as it does to the library.
[src/{PdfPinata.Test,PdfPinata.Charting.Tests,PinataLayout.DocumentObjectModel.Tests,PinataLayout.DocumentObjectModel.Generators.Tests,PinataLayout.Rendering.Tests}/**.cs]
dotnet_diagnostic.CA1861.severity = none
dotnet_diagnostic.CA1859.severity = none
dotnet_diagnostic.SYSLIB1045.severity = none

# Naming. Private instance fields are _camelCase, which is what the code already does and what
# InspectCode's own default (no prefix) would otherwise ask every one of them to stop doing.
# Internal and protected instance fields are PascalCase. The private rule is mirrored in
# src/PdfPinata.sln.DotSettings for ReSharper and Rider.
[*.cs]
dotnet_naming_rule.private_instance_fields_underscore.symbols = private_instance_fields
dotnet_naming_rule.private_instance_fields_underscore.style = underscore_camel_case
dotnet_naming_rule.private_instance_fields_underscore.severity = suggestion

dotnet_naming_rule.non_private_instance_fields_pascal.symbols = non_private_instance_fields
dotnet_naming_rule.non_private_instance_fields_pascal.style = pascal_case
dotnet_naming_rule.non_private_instance_fields_pascal.severity = suggestion

dotnet_naming_symbols.private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.private_instance_fields.applicable_accessibilities = private

dotnet_naming_symbols.non_private_instance_fields.applicable_kinds = field
dotnet_naming_symbols.non_private_instance_fields.applicable_accessibilities = internal, protected, protected_internal, private_protected

dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.underscore_camel_case.capitalization = camel_case

dotnet_naming_style.pascal_case.capitalization = pascal_case
