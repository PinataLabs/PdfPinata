<Project>

  <PropertyGroup>
    <!--
      Every shipped package multi-targets netstandard2.1;net8.0;net10.0. Without this, each leg gets
      the SDK's default C# version for its TFM - netstandard2.1 would compile as C# 8.0 while net8.0
      gets C# 12 and net10.0 gets C# 14, so shared source using anything newer than C# 8 fails to
      build on the netstandard2.1 leg only.

      Raising this unlocks syntax, not runtime support. Features needing BCL types that
      netstandard2.1 lacks (IsExternalInit for records and init accessors, RequiredMemberAttribute
      for required members, InlineArray/CollectionBuilder for some collection expression targets)
      still fail, as a missing-predefined-type error. PolySharp, referenced below for the
      netstandard legs, generates the types; Polyfills/ holds the members. See "Target frameworks"
      in the README for why netstandard2.1 is a target at all.
    -->
    <LangVersion>latest</LangVersion>

    <!--
      CS8073 - "the result of the expression is always false since a value of type T is never equal
      to null of type T?" - is the only thing between a mis-edited struct comparison and a silently
      always-false condition. Comparing a struct that defines operator == against null compiles
      fine, lifts to Nullable<T>, and is never true.

      This is not hypothetical here. Migrating the DOM's nullable wrapper structs turned
      style.IsNull into style == null on four NEnum fields. Two stopped compiling. The other two
      compiled, were always false, and only CS8073 said so. Two more sites in LeftPosition and
      TopPosition would have gone the other way, to an always-true check, for the same reason.

      The tree is clean of it, so this costs nothing today and makes the next such edit fail loudly.
    -->
    <WarningsAsErrors>$(WarningsAsErrors);CS8073</WarningsAsErrors>
  </PropertyGroup>

  <!--
    Polyfills/ holds the members the .NET analyzers ask for that netstandard2.1 lacks - the throw
    helpers, the generic Enum overloads - as internal static extension members. They are compiled
    into the netstandard2.1 leg alone, so the net8.0 and net10.0 legs bind the same source to the
    runtime's own methods. Polyfills/README.md says more.
  -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <Compile Include="$(MSBuildThisFileDirectory)Polyfills/*.cs" Link="Polyfills/%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    PolySharp generates, as internal source, the attributes and types the compiler and the trimming
    annotations need that netstandard lacks - IsExternalInit, CallerArgumentExpressionAttribute,
    DynamicallyAccessedMembersAttribute and the rest - and only those the compilation does not
    already have, so on net8.0 and net10.0 it would generate nothing and is not referenced there.
    It is a source generator with no runtime part, so no package takes a dependency on it.
    DynamicallyAccessedMembers is one of what PolySharp calls runtime-supported attributes, which
    it leaves out unless asked. Polyfills/ above holds the members PolySharp does not provide: it
    polyfills types, never methods.
  -->
  <PropertyGroup>
    <PolySharpIncludeRuntimeSupportedAttributes>true</PolySharpIncludeRuntimeSupportedAttributes>
  </PropertyGroup>

  <ItemGroup Condition="$(TargetFramework.StartsWith('netstandard'))">
    <PackageReference Include="PolySharp" Version="1.16.0" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>

  <!--
    Every package versions in lockstep from one git tag: MinVer reads v1.1.0 and every package it
    packs is 1.1.0. On a commit that is not exactly a tag it computes the next patch as a
    pre-release (1.1.1-alpha.0.3), which is what release-prerelease.yml publishes. MinVer itself is
    referenced from Directory.Build.targets, where IsPackable is known.

    MinVerMinimumMajorMinor is the floor before the first tag exists. PdfPinata and PinataLayout are
    new package IDs and start below 1.0, at 0.1, while the API settles under its new name: until the
    first tag exists, a pre-release is 0.1.0-alpha.0.N rather than MinVer's 0.0.0-alpha.0.N. A tag always
    wins over this floor - it only decides the version of an untagged commit.
  -->
  <PropertyGroup>
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
  </PropertyGroup>

  <!--
    Symbol packages and Source Link. The SDK carries Source Link for GitHub itself from .NET 8 on,
    so nothing needs referencing: these say what goes into the package. The .snupkg is pushed
    beside the .nupkg by the release workflows.
  -->
  <PropertyGroup>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <!-- A deterministic build on CI: the same binary regardless of the machine or path building it. -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' != ''">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    MinVer computes the version inside a target, so a release-notes link that names it has to be
    built after that target runs. As an ordinary property it would interpolate an empty version and
    link to "releases/tag/". Only packable projects reference MinVer, hence the condition.
  -->
  <Target Name="SetPackageReleaseNotesFromVersion" DependsOnTargets="MinVer" BeforeTargets="GenerateNuspec" Condition="'$(IsPackable)' != 'false'">
    <PropertyGroup Condition="'$(MinVerVersion)' != ''">
      <PackageReleaseNotes>See https://github.com/PinataLabs/PdfPinata/releases/tag/$(MinVerTagPrefix)$(MinVerVersion)</PackageReleaseNotes>
    </PropertyGroup>
  </Target>

</Project>
