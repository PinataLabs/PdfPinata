<?xml version="1.0" encoding="utf-8" ?>
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <!-- OpenCover format carries the cyclomatic complexity that CRAP scores need. -->
          <Format>cobertura,opencover</Format>

          <!-- Test, benchmark and demonstration assemblies are not the code under measure. -->
          <Exclude>[*.Tests]*,[*.Test]*,[*.Benchmarks]*,[PinataLayout.AotSmokeTest]*,[SampleApp]*</Exclude>

          <ExcludeByAttribute>Obsolete,GeneratedCodeAttribute,CompilerGeneratedAttribute,ExcludeFromCodeCoverageAttribute</ExcludeByAttribute>

          <!-- The DOM's property machinery is source-generated; measuring it measures the generator. -->
          <ExcludeByFile>**/obj/**/*,**/*.g.cs,**/*.designer.cs</ExcludeByFile>

          <IncludeTestAssembly>false</IncludeTestAssembly>
          <SingleHit>false</SingleHit>
          <!--
            Off deliberately. With SourceLink on, ReportGenerator resolves every file through
            raw.githubusercontent.com - minutes of fetching, 404s for the generated .g.cs the
            DOM builds locally, and file paths in the report that no editor can open.
          -->
          <UseSourceLink>false</UseSourceLink>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
